# Local dev Postgres — matches docker-compose.yml. Run `docker compose up -d`
# then `npx prisma migrate dev` before starting the app.
DATABASE_URL="postgresql://port:port@localhost:5432/port"

# Generate with `npx auth secret`, or `openssl rand -base64 33`.
AUTH_SECRET=""

# Google OAuth client, from console.cloud.google.com.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# One-time bootstrap: the first Google account to sign in with this
# email is auto-approved and made Platform Owner. Clear it after that
# first sign-in so it doesn't grant owner to someone else later.
OWNER_EMAIL=""

# Public origin the app is served from — used to build the absolute
# URL a portfolio's QR code encodes (/p/[stableSlug]).
SITE_URL="http://localhost:3000"

# From resend.com (free tier is plenty for this). Powers the two
# notification emails: new sign-up waiting for approval (to the
# Owner), and approved/rejected (to the applicant). Left unset,
# emails are silently skipped (logged, not sent) — nothing else
# breaks.
RESEND_API_KEY=""
